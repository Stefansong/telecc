# telecc systemd unit file
# Copy to /etc/systemd/system/telecc.service and edit paths, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable telecc
#   sudo systemctl start telecc

[Unit]
Description=telecc - Claude Code Telegram Bot
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/tools/telecc
ExecStart=/usr/bin/node dist/workspace-telegram-bot.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

StandardOutput=append:/home/YOUR_USERNAME/tools/telecc/logs/bot-stdout.log
StandardError=append:/home/YOUR_USERNAME/tools/telecc/logs/bot-stderr.log

[Install]
WantedBy=multi-user.target
